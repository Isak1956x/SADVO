@using SADVO.Core.Application.ViewModels

@model List<CandidatoViewModel>;
@{
    ViewData["Title"] = "User Index";
    Layout = "_LayoutDirigente";
}
@{
    var isElectionActive = ViewBag.EleccionActiva;
}

<div class="container mt-4">
    <h2 class="text-center">Mantenimiento de Candidatos</h2>
  
	@if (isElectionActive)
	{
        <div class="alert alert-warning text-center">
            ⚠️ No se permite crear ni editar mientras haya una elección activa.
        </div>
        <div class="text-end mb-3">
            <button class="btn btn-primary" disabled>Crear Candidato</button>
        </div>
	}
    else
    {
        <div class="text-end mb-3">
            <a class="btn btn-primary" asp-controller="Candidato" asp-action="Create">Crear Candidato</a>
        </div>
    }
    @if (Model.Count == 0)
    {
        <div class="text-center">
            <h5 class="display-4">No Hay Partidos Creados</h5>
        </div>
    }
    else
    {

  

 
      

        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Foto</th>
                        <th>Puesto Electivo</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
            <tbody >
             

                @foreach (var item in Model)
                {
                    <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Apellido</td>
                            <td class ="text-center align-middle"><img src="@item.FotoUrl" class="rounded" style="max-width: 80px;" /></td>
							<td class="text-center align-middle">@item.NombrePuesto
                            </td>
                    <td><span class="badge bg-@(item.EstaActivo ? "success" : "danger")">@(item.EstaActivo ? "Activo" : "Inactivo")</span></td>
                    <td class="text-center">
                                @if (!isElectionActive)
                                {
                                    <a class="btn btn-outline-warning btn-sm float-end me-2" title="Edit"
                                       asp-controller="Candidato" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    <a class="btn btn-outline-@(item.EstaActivo ? "danger" : "success") btn-sm float-end me-2" 
                                       asp-controller="Candidato" asp-action="UpdateStatus" asp-route-id="@item.Id">
                                        <i class="@(item.EstaActivo ? "bi bi-eye-slash-fill" : "bi bi-eye-fill")"></i> @(item.EstaActivo ? "Desactivar" : "Activar")
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary btn-sm float-end me-2" disabled>
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm float-end me-2" disabled>
                                        <i class="bi bi-eye-slash-fill"></i> Estado
                                    </button>
                                }
                    </td>
                </tr>
                } 
            </tbody>
            </table>
		</div>
    }
</div>
