@using SADVO.Core.Application.ViewModels;
@model UpdateCandidatoViewModel; 
 @{     
     	bool editMode = ViewBag.EditMode ?? false;     
     	ViewData["Title"] = "Editar Candidato";     
	Layout = "_LayoutAdmin";
     }     

<div class="col-12 col-md-6 offset-md-3 ">
    <div class="card">
        <div class="card-header bg-success text-light"><h5 class="text-center">"Editar "+  @Model.Nombre</h5></div>
        <div class="card-body">
            <form asp-controller="Candidato" asp-action="Edit" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre:</label>
                    <input class="form-control" asp-for="Nombre" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Apellido" class="form-label">Apellido:</label>
                    <input class="form-control" asp-for="Apellido" />
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="FotoUrl" class="form-label">Foto:</label>
                    <input class="form-control" asp-for="FotoUrl" />
                    <span asp-validation-for="FotoUrl" class="text-danger"></span>
                </div>
                <div>
                    <button type="submit" class="btn btn-outline-primary float-end"><i class="bi bi-floppy2"></i> Guardar</button>
                    <a asp-controller="Candidato" asp-action="Index" class="btn btn-outline-warning float-end me-2"><i class="bi bi-arrow-left-short"></i> Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>


