@using SADVO.Core.Application.ViewModels

@model List<AsignacionPuestoViewModel>;
@{
    ViewData["Title"] = "User Index";
    Layout = "_LayoutDirigente";
    var isElectionActive = ViewBag.EleccionActiva;
}


<div class="container mt-4">
    <h2 class="text-center">Asignacion de Puesto</h2>
 
    @if (isElectionActive)
    {
        <div class="alert alert-warning text-center">
            ⚠️ No se permite crear ni editar mientras haya una elección activa.
        </div>
        <div class="text-end mb-3">
            <button disabled>Crear Relacion</button>
        </div>
    }
    else
    {
        <div class="text-end mb-3">
            <a class="btn btn-primary" asp-controller="AsignacionPuesto" asp-action="Create">Crear Relacion</a>
        </div>
    }
    @if (Model.Count == 0)
    {
        <div class="text-center">
            <h5 class="display-4">No Hay asignaciones de Puesto</h5>
        </div>
    }
    else
    {

 
      

        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre Candidato</th>
                        <th>Apellido</th>
                        <th>Puesto Electivo</th>
						<th>Acciones</th>
                    </tr>
                </thead>
            <tbody >
             

                @foreach (var item in Model)
                {
                    <tr>
                    <td>@item.Candidato.Nombre</td>
                    <td>@item.Candidato.Apellido</td>
                    <td>@item.PuestoElectivo.Nombre</td>
                    <td class="text-center">
                        @if(!isElectionActive)
                        {
                                <a class="btn btn-outline-danger btn-sm float-end" title="delete" asp-asp-controller="AsignacionPuesto" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash"></i>Eliminar</a>
                        }
                        else
                        {
                                    <button class="btn btn-outline-danger btn-sm float-end" disabled><i class="bi bi-trash"></i>Eliminar</button>
                        }
                            </td>
                </tr>
                }
            </tbody>
            </table>
		</div>
    }
</div>
