@using SADVO.Core.Application.ViewModels
@model DeleteAsignacionPuestoViewModel;
@{
	
	ViewData["Title"] = "Eliminar Relacion";
}

<div class="col-12 col-md-6 offset-md-3">
	<div class="card">
		<div class="card-header bg-danger text-light">
			<h4 class="text-center">
				@($"¿Está seguro que desea eliminarla asignacion?")</h4>
		</div>
		<div class="card-body">
			<form asp-controller="AsignacionPuesto" asp-action="Delete" method="POST">
				<input type="hidden" asp-for="Id" />
			
				<div class="mb-3 text-center">
					<button type="submit" class="btn btn-outline-danger ">Eliminar</button>
					<a asp-controller="AsignacionPuesto" asp-action="index" class="btn btn-outline-warning ">Cancelar</a>
				</div>
			</form>
		</div>
	</div>
</div>