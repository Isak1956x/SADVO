@using SADVO.Core.Application.ViewModels;
@model SavePartidoPoliticoViewModel; 
 @{       
     	ViewData["Title"] = "Nuevo Partido";     
	Layout = "_LayoutAdmin";
     }     

<div class="col-12 col-md-6 offset-md-3 ">
    <div class="card">
        <div class="card-header bg-success text-light"><h5 class="text-center">"Nuevo Partido"</h5></div>
        <div class="card-body">
            <form asp-controller="PartidoPolitico" asp-action="Create" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre de Partido:</label>
                    <input class="form-control" asp-for="Nombre" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label">Descripcion:</label>
                    <input class="form-control" asp-for="Descripcion" />
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Siglas" class="form-label">Siglas:</label>
                    <input class="form-control" asp-for="Siglas" />
                    <span asp-validation-for="Siglas" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="LogoUrl" class="form-label">LogoUrl:</label>
                    <input class="form-control" asp-for="LogoUrl" />
                    <span asp-validation-for="LogoUrl" class="text-danger"></span>
                </div>
                <div>
                    <button type="submit" class="btn btn-outline-primary float-end"><i class="bi bi-floppy2"></i> Guardar</button>
                    <a asp-controller="PartidoPolitico" asp-action="Index" class="btn btn-outline-warning float-end me-2"><i class="bi bi-arrow-left-short"></i> Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>


