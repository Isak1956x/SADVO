@using SADVO.Core.Application.ViewModels
@model LoginViewModel
@{
    ViewData["Title"] = "Login Page";
}

<div class="d-flex justify-content-center">

    <div class="col-12 col-md-4">
        <div class="card">
            <div class="card-header bg-success text-light"><h5 class="text-center">Login user</h5></div>
            <div class="card-body">
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                <form asp-controller="Login" asp-action="Index" method="POST">
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">UserName:</label>
                        <input class="form-control" asp-for="Username" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password:</label>
                        <input class="form-control" asp-for="Password" />
                    </div>

                    <div>
                        <button type="submit" class="btn btn-outline-primary float-end"><i class="bi bi-door-open"></i> Login</button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-info float-end me-2"> Volver</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>
