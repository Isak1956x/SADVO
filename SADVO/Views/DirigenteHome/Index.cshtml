@{
    ViewData["Title"] = "User Index";
    Layout = "_LayoutDirigente";
}
@using SADVO.Core.Application.ViewModels
@model DirigenteHomeViewModel;



<div class="text-center">
    <h1 class="display-4">Welcome Dirigente</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<div class="container mt-4">

    <div class="row mb-4 align-items-center">
        <div class="col-md-2">
            <img src="@Model.PartidoPolitico.LogoUrl" alt="Logo del Partido" class="img-fluid rounded" style="max-height: 100px;">
        </div>
        <div class="col-md-10">
            <h2>@Model.PartidoPolitico.Nombre</h2>
            <p class="text-muted">Siglas: <strong>@Model.PartidoPolitico.Siglas</strong></p>
        </div>
    </div>


    <div class="row g-3">

        <div class="col-md-3">
            <div class="card border-primary h-100">
                <div class="card-body">
                    <h5 class="card-title">Candidatos Activos</h5>
                    <p class="card-text display-6">@Model.CandidatosActivos</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-secondary h-100">
                <div class="card-body">
                    <h5 class="card-title">Candidatos Inactivos</h5>
                    <p class="card-text display-6">@Model.CandidatosInactivos</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-success h-100">
                <div class="card-body">
                    <h5 class="card-title">Alianzas Políticas</h5>
                    <p class="card-text display-6">@Model.CantidadAlianzas</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-warning h-100">
                <div class="card-body">
                    <h5 class="card-title">Solicitudes Pendientes</h5>
                    <p class="card-text display-6">@Model.CantidaSolicitudesAlianzas</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-info h-100">
                <div class="card-body">
                    <h5 class="card-title">Candidatos Asignados</h5>
                    <p class="card-text display-6">@Model.CandidatosAsignados</p>
                </div>
            </div>
        </div>

    </div>
</div>

