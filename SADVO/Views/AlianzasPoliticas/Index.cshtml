@using SADVO.Core.Application.ViewModels
@using SADVO.Core.Domain.Enums
@model AlianzaPoliticaIndexViewModel

@{
    ViewData["Title"] = "Alianzas Políticas";
    var eleccionActiva = ViewBag.EleccionActiva;
	Layout = "_LayoutDirigente";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Alianzas Políticas</h2>

    @if (eleccionActiva)
    {
        <div class="alert alert-warning text-center">
            ⚠️ No se pueden crear ni editar mientras exista una elección activa.
        </div>
    }


    <h4>Solicitudes Pendientes de Responder</h4>
    @if (Model.AlianzasPendientes.Any())
    {
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Partido Solicitante</th>
                    <th>Siglas</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var alianza in Model.AlianzasPendientes)
                {
                    <tr>
                        <td>@alianza.PartidoSolicitante.Nombre</td>
                        <td>@alianza.PartidoSolicitante.Siglas</td>
                        <td>@alianza.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (!eleccionActiva)
                            {
                                <a asp-action="UpdateStatus" asp-controller="AlianzasPoliticas" asp-route-id="@alianza.Id" asp-route-Estado="3" class="btn btn-success btn-sm me-2">Aceptar</a>
                                <a asp-action="UpdateStatus" asp-controller="AlianzasPoliticas" asp-route-id="@alianza.Id" asp-route-Estado="2" class="btn btn-danger btn-sm">Rechazar</a>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm me-2" disabled>Aceptar</button>
                                <button class="btn btn-secondary btn-sm" disabled>Rechazar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No hay solicitudes pendientes.</p>
    }

    <hr />

  
    <h4>Solicitudes Enviadas</h4>
    @if(!eleccionActiva)
    {

    <div class="text-end mb-3">
        <a class="btn btn-primary" asp-controller="AlianzasPoliticas" asp-action="Create">Nueva Solicitud</a>
    </div>
    }else
    {

        <div class="text-end mb-3">
            <button class="btn btn-primary" disabled>Nueva Solicitud</button>
        </div>
    }
    @if (Model.AlianzasEnviadas.Any())
    {
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Partido Destino</th>
                    <th>Siglas</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var alianza in Model.AlianzasEnviadas)
                {
                    <tr>
                        <td>@alianza.PartidoDestino.Nombre</td>
                        <td>@alianza.PartidoDestino.Siglas</td>
                        <td>@alianza.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                        <td>
                            @{
                                var estado = ((AlianzaEstado)alianza.Estado).ToString();
                            }
                            <span class="badge bg-@(
                                alianza.Estado == (int)AlianzaEstado.Aceptada ? "success" :
                                alianza.Estado == (int)AlianzaEstado.Rechazada ? "danger" : "warning"
                            )">@estado</span>
                        </td>
                        <td>
                            @if (!eleccionActiva)
                            {
                                <a asp-action="Delete" asp-controller="AlianzasPoliticas" asp-route-id="@alianza.Id" class="btn btn-outline-danger btn-sm">Eliminar</a>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm" disabled>Eliminar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No hay solicitudes enviadas.</p>
    }

    <hr />


    <h4>Alianzas Vigentes</h4>
    @if (Model.AlianzasAceptadas.Any())
    {
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Partido Aliado</th>
                    <th>Siglas</th>
                    <th>Fecha de Solicitud</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var alianza in Model.AlianzasAceptadas)
                {
                    var aliado = alianza.PartidoSolicitanteId == alianza.PartidoDestinoId
                    ? alianza.PartidoSolicitante
                    : (alianza.PartidoSolicitanteId == Model.AlianzasPendientes.FirstOrDefault()?.PartidoDestinoId
                    ? alianza.PartidoDestino
                    : alianza.PartidoSolicitante);

                    <tr>
                        <td>@aliado.Nombre</td>
                        <td>@aliado.Siglas</td>
                        <td>@alianza.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No hay alianzas vigentes.</p>
    }
</div>
